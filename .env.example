# SECURITY WARNING: keep the secret key used in production secret!
SECRET_KEY=

# Illinois Chat — Colab-style (see https://chat.illinois.edu → Settings → API Keys)
ILLINOIS_API_KEY=
ILLINOIS_API_URL=https://chat.illinois.edu/api/chat-api/chat
# Request Builder `course_name` for your project (defaults to Subflo in code if unset)
ILLINOIS_PROJECT_NAME=Subflo
# Model id (must match Request Builder / LLMs tab), e.g. qwen3:32b, gpt-oss:20b
ILLINOIS_MODEL=qwen3:32b
# Optional BYOK for OpenAI-backed models: https://docs.uiuc.chat/api/endpoints
# OPENAI_API_KEY_FOR_UIUC=

# Legacy (no longer used by cancel-guide; email/other features may still reference env elsewhere)
GEMINI_API_KEY=